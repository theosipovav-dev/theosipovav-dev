{
  "Urls": "http://0.0.0.0:5080",

  "ConnectionStrings": {
    "Default": "Host=pg.example.local;Port=5432;Database=tflexdocscontrol;Username=tflexdocscontrol;Password=CHANGE_ME"
  },

  "Jwt": {
    "Key": "СГЕНЕРИРУЙТЕ: openssl rand -base64 48"
  },

  "Bootstrap": {
    "AdminUsername": "admin",
    "AdminPassword": ""
  },

  "ServiceControl": {
    "UseSudoForControl": true,
    "UseSudoForJournal": false,
    "Services": [
      {
        "Id": "tflexdocs-main",
        "Unit": "tflexdocs-main.service",
        "DisplayName": "Сервер приложений",
        "Group": "Основной экземпляр",
        "AllowControl": true
      },
      {
        "Id": "tflexdocs-test",
        "Unit": "tflexdocs-test.service",
        "DisplayName": "Сервер приложений",
        "Group": "Тестовый экземпляр",
        "AllowControl": true
      }
    ],
    "Discovery": [
      {
        "Pattern": "tflexdocs@*.service",
        "DisplayName": "Сервер приложений {instance}",
        "Group": "Экземпляр {instance}",
        "AllowControl": true
      }
    ]
  }
}
