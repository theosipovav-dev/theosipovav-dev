# /etc/sudoers.d/tflexdocscontrol
# Установка: sudo install -m 0440 deploy/sudoers-tflexdocscontrol /etc/sudoers.d/tflexdocscontrol
# Проверка:  sudo visudo -cf /etc/sudoers.d/tflexdocscontrol
#
# Разрешает пользователю tflexctl только start/stop/restart перечисленных unit-ов без пароля.
# Аргументы должны совпадать в точности с тем, что вызывает backend:
#   systemctl <start|stop|restart> <unit> --no-pager
# Добавьте по три строки на каждую службу из ServiceControl:Services.

Cmnd_Alias TFLEXDOCS_CTL = \
    /usr/bin/systemctl start tflexdocs.service --no-pager, \
    /usr/bin/systemctl stop tflexdocs.service --no-pager, \
    /usr/bin/systemctl restart tflexdocs.service --no-pager

Defaults:tflexctl !requiretty
tflexctl ALL=(root) NOPASSWD: TFLEXDOCS_CTL
