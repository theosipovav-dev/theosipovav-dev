{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "EnableSwagger": false,

  "ConnectionStrings": {
    "Default": "Host=db.example.local;Port=5432;Database=tflexdocscontrol;Username=tflexdocscontrol;Password=CHANGE_ME"
  },

  "Jwt": {
    "Issuer": "TFlexDocsControl",
    "Audience": "TFlexDocsControl",
    "Key": "",
    "ExpiresMinutes": 480
  },

  "Bootstrap": {
    "AdminUsername": "admin",
    "AdminPassword": ""
  },

  "Cors": {
    "Origins": []
  },

  "ServiceControl": {
    "SystemctlPath": "/usr/bin/systemctl",
    "JournalctlPath": "/usr/bin/journalctl",
    "SudoPath": "/usr/bin/sudo",
    "UseSudoForControl": true,
    "UseSudoForJournal": false,
    "CommandTimeoutSeconds": 60,
    "MaxLogLines": 2000,
    "Services": [
      {
        "Id": "tflexdocs-server",
        "Unit": "tflexdocs.service",
        "DisplayName": "Сервер приложений T-FLEX DOCs",
        "Description": "Пример. Замените на реальное имя unit-а.",
        "AllowControl": true
      }
    ]
  }
}
